# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://[db_user]:[db_password]@[db_host]:[db_port]/[db_name]?schema=public"

# Authentication Secrets (Use long random strings of 32+ characters)
JWT_SECRET="your_secure_random_jwt_secret_key_32_characters_long"
JWT_EXPIRE="8h"
JWT_REFRESH_SECRET="your_secure_random_jwt_refresh_secret_key_32_characters_long"
JWT_REFRESH_EXPIRE="7d"

# File Upload Configuration
MAX_UPLOAD_SIZE=5242880 # 5MB limit in bytes

# Frontend Configuration
VITE_API_URL="http://localhost:5000/api"
