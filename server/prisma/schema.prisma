datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum Status {
  PRESENT
  ABSENT
}

enum ExamType {
  INTERNAL1
  INTERNAL2
  SEMESTER
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique // e.g. AIDS, CSE
  users     User[]
  students  Student[]
  faculty   Faculty[]
  subjects  Subject[]
}

model User {
  id                String       @id @default(uuid())
  name              String
  email             String       @unique
  passwordHash      String
  role              Role
  createdAt         DateTime     @default(now())
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  studentProfile    Student?
  facultyProfile    Faculty?
  markedAttendance  Attendance[] @relation("MarkedByRelation")
  auditLogs         AuditLog[]   @relation("UserAuditLogs")
  notifications     Notification[] @relation("UserNotifications")
}

model Student {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNo          String         @unique
  batchYear       String // e.g. "2024-2028"
  section         String // e.g. "A"
  mobileNo        String
  guardianContact String
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  attendance      Attendance[]
  marks           Mark[]
  notifications   Notification[]

  @@index([departmentId])
  @@index([batchYear, section])
}

model Faculty {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation  String
  subjects     Subject[]

  @@index([departmentId])
}

model Subject {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique // e.g. AD401
  semester     Int
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  facultyId    String
  faculty      Faculty      @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  attendance   Attendance[]
  marks        Mark[]

  @@index([departmentId])
  @@index([facultyId])
}

model Attendance {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  date       DateTime @db.Date
  status     Status
  markedById String
  markedBy   User     @relation("MarkedByRelation", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, date])
  @@index([studentId])
  @@index([subjectId])
  @@index([date])
  @@index([markedById])
}

model Mark {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  examType      ExamType
  marksObtained Float
  maxMarks      Float

  @@unique([studentId, subjectId, examType])
  @@index([studentId])
  @@index([subjectId])
  @@index([examType])
}

model Notification {
  id                String    @id @default(uuid())
  
  // Legacy / Transitional fields
  studentId         String?
  student           Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Modern targets
  userId            String?
  user              User?     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  // Payload
  title             String?
  message           String
  type              String    // E.g., "ATTENDANCE_WARNING", "MARKS_PUBLISHED"
  priority          String    @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"
  readStatus        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  readAt            DateTime?
  relatedEntityType String?   
  relatedEntityId   String?   
  archivedAt        DateTime?

  @@index([studentId])
  @@index([userId])
  @@index([createdAt])
  @@index([readStatus])
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique // e.g., "low_attendance_threshold"
  value String
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  actorUser     User?    @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole     String
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  timestamp     DateTime @default(now())
  ipAddress     String?
  apiRoute      String?
  httpMethod    String?

  @@index([timestamp])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}
